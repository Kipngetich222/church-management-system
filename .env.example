# ---------------------------------------------------------------------------
# Church Management API (NestJS)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Public URL of this API (used for provider callbacks)
API_PUBLIC_URL=http://localhost:4000
# Comma separated list of allowed browser origins (Next.js web app, Expo, etc.)
CORS_ORIGINS=http://localhost:3000

# Supabase (Project Settings -> API)
SUPABASE_URL=
# Service role key - server only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=
# Publishable / anon key (used as a fallback and for auth verification)
SUPABASE_ANON_KEY=

# Shared secret used to authenticate scheduled cron endpoints
CRON_SECRET=

# Africa's Talking (SMS)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_ENV=sandbox

# M-Pesa (Safaricom Daraja API)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM=

# Contact form destination
CONTACT_EMAIL=