# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for privileged server-side lookups (for example
# resolving the pastors/leaders a prayer request can be sent to).
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL of the web app - used for QR codes and share links
NEXT_PUBLIC_APP_URL=

# Default phone country for phone inputs (ISO code: KE, UG, TZ, ...)
NEXT_PUBLIC_DEFAULT_PHONE_COUNTRY=KE

# Africa's Talking (SMS)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_ENV=sandbox
AFRICAS_TALKING_SENDER_ID=
# Platform selling price per SMS part, in KES. Required to enable purchases.
SMS_CREDIT_PRICE_KES=
# Separate random secrets, at least 32 bytes, for payment / delivery callbacks.
SMS_PAYMENT_CALLBACK_SECRET=
SMS_DELIVERY_CALLBACK_SECRET=

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Required by every cron route; scheduled messages run every minute.
CRON_SECRET=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
# Verified sender. While testing without a verified domain, use:
# ChurchOnline <onboarding@resend.dev>
RESEND_FROM=

# Public contact details and contact-form destination
CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
